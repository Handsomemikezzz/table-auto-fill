{
  "name": "fill-ease",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.content.config.ts && node scripts/post-build.js",
    "package:extension": "npm run build && node scripts/package-extension.js",
    "lint": "oxlint",
    "test:extension-smoke": "node scripts/smoke-test-extension.js",
    "test:options": "tsx --test src/options/singlePageProfile.test.tsx src/options/DataBackupSettings.test.tsx src/options/ProfileImportDraft.test.tsx src/popup/productScope.test.tsx",
    "test:profile": "tsx --test src/shared/basicInfo.test.ts src/utils/fieldMatcher.test.ts",
    "test": "node --experimental-strip-types --test src/shared/backup.test.ts src/shared/packageScripts.test.ts src/shared/resumes.test.ts src/utils/resume-parse.test.ts src/utils/dateValue.test.ts src/background/contentScriptConnection.test.ts src/content/infoOverlay.test.ts src/parsers/offscreen-routing.test.ts src/utils/optionResolver.test.ts src/content/datePickerAdapter.test.ts src/content/cascaderAdapter.test.ts src/content/fieldBinding.test.ts && npm run test:profile && npm run test:options && npm run test:autofill && npm run test:site-eval && npm run test:resume-review && npm run test:benchmark",
    "preview": "vite preview",
    "test:form-fill": "npm run build && node scripts/test-form-fill.js",
    "test:form-fill:browser": "node scripts/test-form-fill.js",
    "test:autofill": "node --experimental-strip-types --test src/autofill/ruleAutofill.test.ts",
    "eval:fields": "tsx scripts/evaluate-site-fields.ts",
    "test:site-eval": "tsx --test tests/site-eval/scoring.test.ts",
    "test:resume-review": "tsx --test src/autofill/resumeReview.test.ts",
    "test:resume-import:browser": "node scripts/test-resume-import.js",
    "benchmark": "npm run build && node scripts/benchmark.js",
    "benchmark:browser": "node scripts/benchmark.js",
    "benchmark:check": "npm run benchmark -- --compare tests/benchmark/baselines/2026-10-08-v1.json",
    "test:benchmark": "node --test tests/benchmark/scoring.test.js"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.6",
    "pdfjs-dist": "6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "antd": "^6.5.0",
    "canvas": "^3.2.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.10",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
